APP_NAME=CareerLens AI
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
APP_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

DB_NAME=careerlens
DB_USER=careerlens_user
DB_PASSWORD=replace_with_a_generated_password
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace_with_a_generated_secret_of_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
CELERY_TASK_ALWAYS_EAGER=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RESUME_STORAGE_DIR=backend/var/private-resumes
RESUME_ENCRYPTION_KEY=
RESUME_MAX_FILE_SIZE_BYTES=10485760
RESUME_MAX_PAGES=100
RESUME_MAX_EXTRACTED_CHARS=1000000
SKILL_TAXONOMY_PATH=backend/app/ml/skill_taxonomy.json
SPACY_MODEL=en_core_web_sm
MATCHING_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MATCHING_MAX_SEARCH_CANDIDATES=500
MATCHING_SKILL_WEIGHT=0.35
MATCHING_EXPERIENCE_WEIGHT=0.30
MATCHING_SEMANTIC_WEIGHT=0.25
MATCHING_EDUCATION_WEIGHT=0.10

VITE_API_BASE_URL=http://localhost:8000/api/v1
